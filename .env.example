# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, NEVER exposed to the browser. Used by /api/admin/* routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin auth ---
# Simple email/password gate for the admin dashboard (checked against Supabase Auth).
# Create the admin user once in Supabase Auth (Authentication -> Users -> Add user).
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# --- AI Assistant (Ask Viky AI) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_NOTIFICATION_EMAIL=contact@vikyaditama.com
